        "operation": "upload",
        "title": "={{ $json.title }}",
        "regionCode": "US",
        "categoryId": "22",
        "options": {
          "description": "={{ $json.description + '\\n\\n' + $json.hashtags.join(' ') }}",
          "privacyStatus": "private"
        }
