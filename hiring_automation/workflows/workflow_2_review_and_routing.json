        ]
      ]
    },
    "1. Fetch Scored Pending Candidates": {
      "main": [
        [
          {
            "node": "2. Route by Candidate Classification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Route by Candidate Classification": {
      "main": [
        [
          {
            "node": "3A. Send HTML Shortlist Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "3B. Alert Hiring Manager",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "3C. Send Courteous Rejection Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3A. Send HTML Shortlist Email": {
      "main": [
