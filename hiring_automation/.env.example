# ==============================================================================
# DevSynt Hiring Automation - Environment Configuration Template
# Copy this file to .env and fill in the appropriate credentials before starting.
# ==============================================================================

# n8n Environment Configuration
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=super-secret-key-change-in-production

# Supabase Credentials (PostgreSQL / REST API)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_PORT=5432

# OpenAI / AI Resume Screening API Key
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Email Intake (IMAP Settings for careers@devsynt.com)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=careers@devsynt.com
IMAP_PASSWORD=your-app-password
IMAP_TLS=true

# Outbound Email (SMTP / N8N Email Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=careers@devsynt.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_NAME=DevSynt Hiring Team
HIRING_MANAGER_EMAIL=hiring.manager@devsynt.com

# Google Forms / Sheets Trigger (Google OAuth Credentials)
GOOGLE_SHEET_ID=your-google-sheet-id-for-form-responses
